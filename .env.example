# ── Claude (説明文の生成に使用) ───────────────────────────────
# https://console.anthropic.com で取得した API キー
ANTHROPIC_API_KEY=sk-ant-...
# 説明に使うモデル（省略時 claude-opus-4-8）
JANTAMA_CLAUDE_MODEL=claude-opus-4-8
# 思考の深さ low | medium | high | max（省略時 medium）
JANTAMA_CLAUDE_EFFORT=medium
# 1 説明あたりの最大出力トークン（省略時 4000）
JANTAMA_MAX_TOKENS=4000

# ── 解析エンジン ─────────────────────────────────────────────
# mortal(高精度・要モデル重み) | efficiency(ゼロ設定の牌効率・Mortal不要)
JANTAMA_ENGINE=mortal
# mjai-reviewer 実行ファイルのパス（https://github.com/Equim-chan/mjai-reviewer）
MJAI_REVIEWER_PATH=mjai-reviewer
# Mortal のモデル重み(.pth)とエンジン設定。重みは各自で用意する必要があります。
MORTAL_MODEL_PATH=
MORTAL_DEVICE=cpu
# フラグがバージョンで違う場合、起動コマンドを完全上書き（{in}{out}{actor}{model}）
# 例: MJAI_REVIEWER_CMD=mjai-reviewer -e mortal -i {in} -a {actor} --json -o {out}
MJAI_REVIEWER_CMD=

# ── 雀魂 牌譜の取得 ───────────────────────────────────────────
# 雀魂→mjai/天鳳 への変換ツール（例: tensoul）の実行ファイルのパス
TENSOUL_PATH=
# 雀魂ログ取得に使うアクセストークン or 認証情報（変換ツールに渡す）
MAJSOUL_ACCESS_TOKEN=
# 変換ツールの起動コマンドを完全上書き（{id}{out}{token} を置換。出力は天鳳形式）
# 例: MAJSOUL_FETCH_CMD=tensoul {id} -o {out} --token {token}
MAJSOUL_FETCH_CMD=

# ── Discord bot ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── 解析のしきい値 ───────────────────────────────────────────
# 推奨打牌との価値差(EV)がこの値を超えたら「ミス」として説明対象にする
JANTAMA_MISTAKE_EV_THRESHOLD=0.05
# 1 局の牌譜から説明する最大件数（多すぎる出力を防ぐ）
JANTAMA_MAX_EXPLANATIONS=8
